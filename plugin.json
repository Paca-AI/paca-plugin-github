{
  "id": "com.paca.github",
  "displayName": "GitHub Integration",
  "description": "Integrates GitHub repositories, pull requests, and branches with Paca projects and tasks.",
  "version": "0.6.0",
  "minCoreVersion": "v0.19.0",
  "capabilities": ["repository"],
  "permissions": ["db.read", "db.write"],
  "customPermissions": [
    {
      "key": "github:manage",
      "label": "Manage GitHub integration",
      "description": "View and manage this project's GitHub integration: connect or disconnect the access token, and link or unlink repositories. Does not affect PR/branch info on individual tasks, which any project member with task access can already see.",
      "scope": "project"
    },
    {
      "key": "github:manage_apps",
      "label": "Manage GitHub Apps",
      "description": "Instance-wide: create GitHub Apps through the manifest flow, install them on GitHub accounts and organizations, choose which projects may use each installation, and delete apps. Project managers can only pick from the installations made available to their project.",
      "scope": "global"
    }
  ],
  "backend": {
    "allowedConfigKeys": ["ENCRYPTION_KEY", "PUBLIC_URL"],
    "allowedOutboundDomains": ["api.github.com"],
    "sensitiveFields": {
      "github_integrations": ["access_token_enc"],
      "github_repositories": ["webhook_secret_enc"],
      "github_apps": ["client_secret_enc", "webhook_secret_enc", "private_key_enc"]
    },
    "routes": [
      {
        "method": "GET",
        "path": "/projects/:projectId/integration",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["github:manage"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/integration/token",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["github:manage"]
          }
        ]
      },
      {
        "method": "DELETE",
        "path": "/projects/:projectId/integration/token",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["github:manage"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/integration/accessible-repos",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["github:manage"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/repositories",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["github:manage"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/repositories",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["github:manage"]
          }
        ]
      },
      {
        "method": "DELETE",
        "path": "/projects/:projectId/repositories/:repoId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["github:manage"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/repositories/:repoId/clone-info",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["github:manage"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/tasks/:taskId/pull-requests",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["tasks:read"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/tasks/:taskId/pull-requests",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["tasks:write"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/tasks/:taskId/pull-requests/link",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["tasks:write"]
          }
        ]
      },
      {
        "method": "DELETE",
        "path": "/projects/:projectId/tasks/:taskId/pull-requests/:prId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["tasks:write"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/tasks/:taskId/pull-requests/:prId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["tasks:read"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/tasks/:taskId/pull-requests/:prId/ci-status",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["tasks:read"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/tasks/:taskId/pull-requests/:prId/comments",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["tasks:write"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/tasks/:taskId/pull-requests/:prId/reviews",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["tasks:write"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/tasks/:taskId/branches",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["tasks:read"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/tasks/:taskId/branches",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["tasks:write"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/tasks/:taskId/branches/link",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["tasks:write"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/apps/manifest",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "global",
            "actions": ["github:manage_apps"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/apps/callback/created",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "global",
            "actions": ["github:manage_apps"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/apps/callback/installed",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "global",
            "actions": ["github:manage_apps"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/apps",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "global",
            "actions": ["github:manage_apps"]
          }
        ]
      },
      {
        "method": "DELETE",
        "path": "/apps/:appId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "global",
            "actions": ["github:manage_apps"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/apps/:appId/install",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "global",
            "actions": ["github:manage_apps"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/apps/:appId/installations/:installationId/access",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "global",
            "actions": ["github:manage_apps"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/integration/installations",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["github:manage"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/integration/app",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["github:manage"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/integration/agent-identities",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["github:manage"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/integration/agent-identities",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["github:manage"]
          }
        ]
      },
      {
        "method": "DELETE",
        "path": "/projects/:projectId/integration/agent-identities/:memberId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["github:manage"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/webhooks/apps/:appKey",
        "middlewares": [{ "name": "optionalAuthn" }]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/webhook",
        "middlewares": [{ "name": "optionalAuthn" }]
      }
    ]
  },
  "frontend": {
    "remoteEntryUrl": "/plugins/com.paca.github/assets/remoteEntry.js",
    "extensionPoints": [
      {
        "point": "project.settings.tab",
        "component": "GitHubSettingsTab",
        "label": "GitHub",
        "order": 100,
        "requiredPermission": "github:manage"
      },
      {
        "point": "task.detail.section",
        "component": "GitHubTaskSection",
        "order": 5
      },
      {
        "point": "app.page",
        "component": "GitHubAppCallbackPage",
        "requiredPermission": "github:manage_apps"
      }
    ],
    "navItems": [
      {
        "scope": "app",
        "slug": "github-app-callback",
        "label": "GitHub App setup",
        "component": "GitHubAppCallbackPage",
        "requiredPermission": "github:manage_apps"
      }
    ]
  },
  "automation": {
    "triggers": [
      {
        "type": "github.pr_linked",
        "label": "GitHub: Pull Request Created",
        "eventTopic": "github.pr_linked"
      },
      {
        "type": "github.pr_state_changed",
        "label": "GitHub: Pull Request State Changed",
        "eventTopic": "github.pr_state_changed"
      },
      {
        "type": "github.branch_linked",
        "label": "GitHub: Branch Created",
        "eventTopic": "github.branch_linked"
      }
    ],
    "conditions": [
      {
        "type": "github.pr_state",
        "label": "GitHub: Pull Request State",
        "configSchema": {
          "type": "object",
          "required": ["expected_state"],
          "properties": {
            "expected_state": {
              "type": "string",
              "title": "Expected State",
              "enum": ["open", "closed", "merged"]
            }
          }
        }
      }
    ],
    "actions": [
      {
        "type": "github.merge_pr",
        "label": "GitHub: Merge Pull Request",
        "configSchema": {
          "type": "object",
          "properties": {
            "merge_method": {
              "type": "string",
              "title": "Merge Method",
              "enum": ["merge", "squash", "rebase"],
              "default": "merge"
            }
          }
        }
      },
      {
        "type": "github.comment_pr",
        "label": "GitHub: Comment on Pull Request",
        "configSchema": {
          "type": "object",
          "required": ["body"],
          "properties": {
            "body": { "type": "string", "title": "Comment Body", "format": "textarea" }
          }
        }
      }
    ]
  },
  "mcp": {
    "remoteEntryUrl": "/plugins-mcp/com.paca.github/mcp.js",
    "toolContextHooks": ["get_task"]
  },
  "skills": {
    "baseUrl": "/plugins-skills/com.paca.github",
    "names": ["paca-github-workflow"]
  }
}
