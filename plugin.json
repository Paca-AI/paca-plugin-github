{
  "id": "com.paca.github",
  "displayName": "GitHub",
  "description": "GitHub provider for Paca's Git integration: GitHub App identities, repository access, credentials and webhooks.",
  "version": "0.8.0",
  "minCoreVersion": "v0.19.0",
  "capabilities": ["git-provider"],
  "permissions": ["db.read", "db.write"],
  "backend": {
    "allowedConfigKeys": ["ENCRYPTION_KEY"],
    "allowedOutboundDomains": ["api.github.com"],
    "sensitiveFields": {
      "github_apps": ["client_secret_enc", "webhook_secret_enc", "private_key_enc"]
    }
  }
}
